# ---------------------------------------------------------------------------------------------
# Memory Firewall — example environment. SAFE PLACEHOLDERS ONLY.
#
# `make setup` writes a real `.env` with randomly generated local tokens. That file is gitignored.
# Nothing here is required for the default demo: there is no model API key, no cloud account and
# no paid service anywhere in setup, dev, smoke, test, eval, verify or screenshots.
# ---------------------------------------------------------------------------------------------

# --- storage ---------------------------------------------------------------------------------
MF_DB_PATH=data/memory-firewall.sqlite3

# --- local dev binding (localhost only; do not expose these ports) ---------------------------
MF_API_HOST=127.0.0.1
MF_API_PORT=8002
MF_WEB_PORT=5174
MF_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# --- input bounds ----------------------------------------------------------------------------
MF_MAX_DOCUMENT_BYTES=262144
MF_MAX_UPLOAD_BYTES=262144
MF_MAX_RETRIEVE_LIMIT=25

# --- policy knobs ----------------------------------------------------------------------------
# Minimum source trust tier eligible for retrieval. Raising this is a deployment hardening step
# and is one of the measured eval conditions.
#   external_untrusted | unreviewed_internal | reviewed_internal | authoritative_reviewed | authoritative_signed
MF_MIN_RETRIEVAL_TRUST_TIER=external_untrusted

# Reject (400) rather than ignore-and-audit a request body containing identity or privilege
# fields. Both behaviours are tested; ignore-and-audit is the default because it is friendlier to
# debug and strictly no less safe — the fields are stripped before any handler can read them.
MF_STRICT_REJECT_FORGED_FIELDS=0

# Exposes POST /api/demo/unguarded-comparison for the side-by-side demo and the eval baseline.
# Admin role is still required and every response is labelled as a baseline, not a firewall
# result. `make setup` turns this ON for the local demo profile.
MF_ENABLE_UNGUARDED_BASELINE=0

# --- optional tamper evidence ----------------------------------------------------------------
# When set, integrity manifests are HMACs under this key instead of plain SHA-256 digests. The key
# must live OUTSIDE the content database (that is the entire point). Leave unset for the demo.
# MF_HMAC_KEY=replace-with-a-random-32-byte-value-kept-outside-the-db

# --- optional model adapter ------------------------------------------------------------------
# `null` (default) performs no network call and declines rather than inventing an answer. Any other
# value still resolves to the null adapter unless you register your own adapter object; no provider
# client ships with this package, so `make verify` stays offline.
MF_LLM_ADAPTER=null

# Demo principal tokens are generated by `make setup` into .env — never commit real tokens.
# MF_TOKEN_SUPPORT_ROOT=
# MF_TOKEN_SUPPORT_ADMIN=
# MF_TOKEN_SUPPORT_READER=
# MF_TOKEN_OTHER_ADMIN=
# MF_TOKEN_OTHER_READER=
